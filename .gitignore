# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Node
node_modules/

# Evidencia de execucao: gerada por run, nunca versionada.
# O repositorio guarda o metodo, nao o historico de execucoes de uma maquina.
runs/
*.log

# Segredos. O gate scan_secrets tambem reprova, mas a primeira linha de
# defesa e o arquivo nunca entrar no indice.
.env
.env.*
!.env.example
*.pem
*.key
identity.key

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Scratch do subagent-driven-development: ledger, briefs, relatorios e
# pacotes de diff de um plano em execucao. Derivado, regeneravel, e nao
# pertence a um repositorio publico.
.superpowers/

# Configuracao local de agentes desta maquina: skills em `.agents/`, config
# e hooks do Codex CLI em `.codex/`. Sao ajuste de host, nao o metodo. Sem
# esta linha, um `git add -A` publica os dois num repositorio publico.
.agents/
.codex/
