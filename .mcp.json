{
  "mcpServers": {
    "genuino": {
      "command": "uv",
      "args": ["run", "--directory", "mcp", "genuino-mcp"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    }
  }
}
